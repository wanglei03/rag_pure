# ===== 模型接入:mock 为离线默认值,改成 deepseek / dashscope / ollama 即可切真实模型 =====
LLM_PROVIDER=mock            # mock | deepseek | dashscope | ollama
EMBED_PROVIDER=mock          # mock | dashscope | ollama
RERANK_PROVIDER=overlap      # overlap(本地) | dashscope | siliconflow

# ===== 各供应商 Key(用到才需要填)=====
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
SILICONFLOW_API_KEY=

# ===== 可选:覆盖默认模型 =====
# RAG_LLM_MODEL=qwen-plus
# RAG_EMBED_MODEL=text-embedding-v3

# ===== 可调参数 =====
# RAG_CHUNK_SIZE=280
# RAG_CHUNK_OVERLAP=60
# RAG_RETRIEVE_TOP_K=5
